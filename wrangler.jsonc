// Cloudflare Workers: veröffentlicht den Astro-Build (dist/) als statische Dateien, ohne eigenen Worker-Code.
// Veröffentlichen: per GitHub Action (.github/workflows/deploy.yml) bei jedem Push auf main.
// Cloudflare liefert cv.html unter /cv aus (/cv.html → /cv) und ordner/index.html unter /ordner/ (/ordner → /ordner/),
// unbekannte Adressen bekommen 404.html. Alte Adressen mit .html leitet public/_redirects mit 301 weiter.
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "josija-nydegger",
  "compatibility_date": "2026-11-10",
  "assets": {
    "directory": "./dist",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  },
  // Eigene Domain; www leitet eine Redirect-Regel der Zone auf die Domain ohne www um
  "routes": [{ "pattern": "josija-nydegger.ch", "custom_domain": true }],
  // Keine zweite Adresse unter *.workers.dev (sonst doppelte Inhalte für Suchmaschinen).
  // Vorschau-Adressen pro Branch (Pull Requests, siehe deploy.yml) sind an, aber durch Cloudflare Access geschützt:
  // nur nach Anmeldung erreichbar, darum nicht in Suchmaschinen. Siehe _docs/hosting.md.
  "workers_dev": false,
  "preview_urls": true,
  "observability": { "enabled": true }
}
