---
// Suche (Strg/⌘ K, "/" oder Suchknopf oben rechts): durchsucht Seiten, Tools und Beiträge der eigenen Sprache
// und bietet Schnellaktionen (Link kopieren, Lebenslauf als PDF, Farbschema, E-Mail, LinkedIn/GitHub).
// Der Index wird beim Build als JSON in die Seite geschrieben; gesucht wird nur im Browser, nichts wird gesendet.
// Eingebunden in src/layouts/Base.astro. Ohne JavaScript bleibt das Suchfeld ausgeblendet.
import { i18n, type Lang } from '../data/i18n';
import { tools } from '../data/tools';
import { getPosts } from '../lib/posts';
import { site } from '../data/site';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = i18n[lang];
const de = lang === 'de';
const base = de ? '' : '/en';
const home = t.homeUrl;

// t = Titel, d = Beschreibung, u = Adresse, k = Art, s = weitere Suchbegriffe (nicht angezeigt),
// a = Schnellaktion (statt Adresse, ausgeführt im Skript unten), x = Adresse in neuem Tab öffnen
type Entry = { t: string; d: string; u?: string; k: string; s?: string; a?: string; x?: boolean };
const social = (host: string) => site.social.find(u => u.includes(host))!;
const A = t.kindAction;
// Schnellaktionen stehen zuoberst, solange nichts eingegeben ist
const actions: Entry[] = de
  ? [
      { t: 'Link zu dieser Seite kopieren', d: 'Adresse in die Zwischenablage', a: 'copy-link', k: A, s: 'url teilen share' },
      { t: 'Lebenslauf als PDF speichern', d: 'Öffnet den Lebenslauf und den Druckdialog', a: 'cv-pdf', k: A, s: 'cv drucken print download' },
      { t: 'Helles Farbschema', d: 'Hell, unabhängig von der Geräteeinstellung', a: 'theme-light', k: A, s: 'hell light theme modus' },
      { t: 'Dunkles Farbschema', d: 'Dunkel, unabhängig von der Geräteeinstellung', a: 'theme-dark', k: A, s: 'dunkel dark mode nacht theme' },
      { t: 'Farbschema wie das Gerät', d: 'Folgt der Systemeinstellung', a: 'theme-system', k: A, s: 'system auto theme modus' },
      { t: 'E-Mail schreiben', d: 'Öffnet das Mailprogramm', a: 'mail', k: A, s: 'email mail kontakt' },
      { t: 'E-Mail-Adresse kopieren', d: 'Adresse in die Zwischenablage', a: 'copy-mail', k: A, s: 'email mail kontakt' },
      { t: 'LinkedIn', d: 'Profil auf LinkedIn (neuer Tab)', u: social('linkedin'), x: true, k: A, s: 'kontakt' },
      { t: 'GitHub', d: 'Code und Projekte auf GitHub (neuer Tab)', u: social('github'), x: true, k: A, s: 'code' }
    ]
  : [
      { t: 'Copy link to this page', d: 'Copy the address to the clipboard', a: 'copy-link', k: A, s: 'url share' },
      { t: 'Save CV as PDF', d: 'Opens the CV and the print dialog', a: 'cv-pdf', k: A, s: 'resume print download' },
      { t: 'Light mode', d: 'Light, regardless of the device setting', a: 'theme-light', k: A, s: 'theme color scheme' },
      { t: 'Dark mode', d: 'Dark, regardless of the device setting', a: 'theme-dark', k: A, s: 'theme color scheme night' },
      { t: 'Match device color scheme', d: 'Follows the system setting', a: 'theme-system', k: A, s: 'system auto theme mode' },
      { t: 'Write an email', d: 'Opens your email app', a: 'mail', k: A, s: 'email mail contact' },
      { t: 'Copy email address', d: 'Copy the address to the clipboard', a: 'copy-mail', k: A, s: 'email mail contact' },
      { t: 'LinkedIn', d: 'Profile on LinkedIn (new tab)', u: social('linkedin'), x: true, k: A, s: 'contact' },
      { t: 'GitHub', d: 'Code and projects on GitHub (new tab)', u: social('github'), x: true, k: A, s: 'code' }
    ];
const pages: Entry[] = de
  ? [
      { t: 'Start', d: 'Über mich, Arbeiten, Projekte, Kontakt', u: home, k: t.kindPage, s: 'home about' },
      { t: 'Lebenslauf', d: 'Ausbildung, Erfahrung, Kenntnisse', u: '/cv', k: t.kindPage, s: 'cv resume pdf' },
      { t: 'Tools', d: 'Web-Tools zu Statik, Bemessung und Einheiten', u: '/tools/', k: t.kindPage },
      { t: 'Blog', d: 'Alle Beiträge', u: t.blogUrl, k: t.kindPage, s: 'beitraege posts' },
      { t: 'Arbeiten', d: 'Bachelorarbeit ETH, Projektarbeit BFH', u: `${home}#arbeiten`, k: t.kindSection, s: 'pdf comsol windturbine bruecken' },
      { t: 'Projekte', d: 'QR-tool, weather-bot', u: `${home}#projekte`, k: t.kindSection, s: 'github code' },
      { t: 'Kontakt', d: 'LinkedIn, GitHub, E-Mail', u: `${home}#kontakt`, k: t.kindSection, s: 'email mail linkedin' },
      { t: t.privacy, d: 'Welche Daten anfallen', u: t.privacyUrl, k: t.kindPage, s: 'privacy umami statistik' },
      { t: 'RSS-Feed', d: 'Neue Beiträge abonnieren', u: t.feedUrl, k: t.kindPage, s: 'atom feed abonnieren' }
    ]
  : [
      { t: 'Home', d: 'About me, academic work, projects, contact', u: home, k: t.kindPage, s: 'start about' },
      { t: 'CV', d: 'Education, experience, skills', u: `${base}/cv`, k: t.kindPage, s: 'resume lebenslauf pdf' },
      { t: 'Tools', d: 'Web tools for structural analysis, design and units', u: `${base}/tools/`, k: t.kindPage },
      { t: 'Blog', d: 'All posts', u: t.blogUrl, k: t.kindPage, s: 'posts' },
      { t: 'Academic work', d: "Bachelor's thesis ETH, semester project BFH", u: `${home}#work`, k: t.kindSection, s: 'pdf thesis comsol wind turbine bridges' },
      { t: 'Projects', d: 'QR-tool, weather-bot', u: `${home}#projects`, k: t.kindSection, s: 'github code' },
      { t: 'Contact', d: 'LinkedIn, GitHub, email', u: `${home}#contact`, k: t.kindSection, s: 'email mail linkedin' },
      { t: t.privacy, d: 'What data is collected', u: t.privacyUrl, k: t.kindPage, s: 'datenschutz umami statistics' },
      { t: 'RSS feed', d: 'Subscribe to new posts', u: t.feedUrl, k: t.kindPage, s: 'atom feed subscribe' }
    ];
const toolEntries: Entry[] = tools.map(x => ({ t: x.title[lang], d: x.description[lang], u: x.url, k: t.kindTool, s: x.tags[lang].join(' ') }));
const postEntries: Entry[] = (await getPosts(lang)).map(p => ({ t: p.title, d: p.description, u: p.url, k: t.kindPost, s: p.tags.join(' ') }));
// "<" maskieren, damit kein Titel das Skript-Element beenden kann
const index = JSON.stringify([...actions, ...pages, ...toolEntries, ...postEntries]).replace(/</g, '\\u003c');
---
<dialog class="search" aria-label={t.search} data-empty={t.searchEmpty} data-copied={t.copied} data-copy-failed={t.copyFailed} data-cv={`${base}/cv`} data-mail={site.emailB64}>
  <div class="search-input">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg>
    <input type="search" placeholder={t.searchPlaceholder} aria-label={t.search} autocomplete="off" spellcheck="false" role="combobox" aria-expanded="true" aria-controls="search-list">
  </div>
  <ul class="search-list" id="search-list" role="listbox"></ul>
  <div class="search-foot" aria-hidden="true">
    <span><kbd>↵</kbd> {t.searchHelpOpen}</span>
    <span><kbd>↑</kbd><kbd>↓</kbd> {t.searchHelpMove}</span>
    <span><kbd>Esc</kbd> {t.searchHelpClose}</span>
  </div>
</dialog>
<script type="application/json" id="search-index" set:html={index} />

<script>
  type Entry = { t: string; d: string; u?: string; k: string; s?: string; a?: string; x?: boolean };
  const dialog = document.querySelector<HTMLDialogElement>('dialog.search')!;
  const input = dialog.querySelector('input')!;
  const list = dialog.querySelector<HTMLUListElement>('.search-list')!;
  const index: Entry[] = JSON.parse(document.getElementById('search-index')!.textContent || '[]');
  let results: Entry[] = [];
  let sel = 0;

  // Gross/klein und Akzente egal: "uber" findet "Über", "brucke" findet "Brücke"
  const norm = (s: string) => s.toLowerCase().normalize('NFD').replace(/[̀-ͯ]/g, '');
  const haystack = index.map(e => ({ e, title: norm(e.t), all: norm(`${e.t} ${e.d} ${e.s ?? ''} ${e.k}`) }));

  // Alle Wörter müssen vorkommen; Treffer im Titel (vor allem am Anfang) zuerst
  function search(q: string): Entry[] {
    const words = norm(q).split(/\s+/).filter(Boolean);
    if (!words.length) return index;
    return haystack
      .filter(h => words.every(w => h.all.includes(w)))
      .map(h => ({ e: h.e, score: words.reduce((s, w) => s + (h.title.startsWith(w) ? 3 : h.title.includes(w) ? 2 : 0), 0) }))
      .sort((a, b) => b.score - a.score)
      .map(r => r.e);
  }

  function render() {
    results = search(input.value);
    sel = Math.min(sel, Math.max(0, results.length - 1));
    list.replaceChildren();
    if (!results.length) {
      const li = document.createElement('li');
      li.className = 'search-empty';
      li.textContent = dialog.dataset.empty ?? '';
      list.append(li);
      input.removeAttribute('aria-activedescendant');
      return;
    }
    results.forEach((r, i) => {
      const li = document.createElement('li');
      li.id = `search-${i}`;
      li.setAttribute('role', 'option');
      li.setAttribute('aria-selected', String(i === sel));
      // Adresse als Link, Schnellaktion als Knopf
      const a = r.u ? document.createElement('a') : document.createElement('button');
      if (a instanceof HTMLAnchorElement) {
        a.href = r.u!;
        if (r.x) { a.target = '_blank'; a.rel = 'noopener'; }
      } else {
        a.type = 'button';
        a.addEventListener('click', () => run(r, a));
      }
      a.tabIndex = -1;
      for (const [cls, text] of [['t', r.t], ['k', r.k], ['d', r.d]]) {
        const span = document.createElement('span');
        span.className = cls;
        span.textContent = text;
        a.append(span);
      }
      a.addEventListener('mousemove', () => { if (sel !== i) { sel = i; mark(); } });
      li.append(a);
      list.append(li);
    });
    input.setAttribute('aria-activedescendant', `search-${sel}`);
  }
  function mark() {
    list.querySelectorAll('li[role=option]').forEach((li, i) => li.setAttribute('aria-selected', String(i === sel)));
    list.querySelector('[aria-selected=true]')?.scrollIntoView({ block: 'nearest' });
    input.setAttribute('aria-activedescendant', `search-${sel}`);
  }

  function open() {
    if (dialog.open) return;
    input.value = '';
    sel = 0;
    render();
    dialog.showModal();
    input.focus();
  }
  input.addEventListener('input', () => { sel = 0; render(); });
  input.addEventListener('keydown', e => {
    const n = Math.max(1, results.length);
    if (e.key === 'ArrowDown') { e.preventDefault(); sel = (sel + 1) % n; mark(); }
    else if (e.key === 'ArrowUp') { e.preventDefault(); sel = (sel - 1 + n) % n; mark(); }
    else if (e.key === 'Enter' && results[sel]) {
      e.preventDefault();
      const r = results[sel];
      if (r.a) run(r, list.querySelector<HTMLElement>(`#search-${sel} > *`)!);
      else if (r.x) { window.open(r.u, '_blank', 'noopener'); dialog.close(); }
      else { dialog.close(); location.href = r.u!; }
    }
  });
  // Klick auf den Hintergrund oder auf einen Treffer schliesst
  dialog.addEventListener('click', e => {
    if (e.target === dialog || (e.target as Element).closest('a')) dialog.close();
  });

  // Schnellaktionen
  const email = () => { try { return atob(dialog.dataset.mail ?? ''); } catch { return ''; } };
  // Kurze Rückmeldung in der Zeile selbst, dann schliessen
  function feedback(el: HTMLElement, text: string) {
    const d = el.querySelector('.d');
    if (d) d.textContent = text;
    setTimeout(() => dialog.close(), 700);
  }
  async function copy(el: HTMLElement, text: string) {
    try { await navigator.clipboard.writeText(text); feedback(el, `${dialog.dataset.copied} ✓`); }
    catch { feedback(el, dialog.dataset.copyFailed ?? ''); }
  }
  function run(r: Entry, el: HTMLElement) {
    if (r.a === 'copy-link') copy(el, location.origin + location.pathname);
    else if (r.a === 'copy-mail') copy(el, email());
    else if (r.a === 'mail') { dialog.close(); location.href = 'mailto:' + email(); }
    else if (r.a === 'cv-pdf') {
      dialog.close();
      // Auf dem Lebenslauf direkt drucken, sonst dorthin wechseln (#pdf öffnet dort den Druckdialog, siehe Base.astro)
      const print = document.querySelector<HTMLButtonElement>('[data-print]');
      if (print) print.click(); else location.href = `${dialog.dataset.cv}#pdf`;
    } else if (r.a?.startsWith('theme-')) {
      // Über die Knöpfe in der Fusszeile, damit die Auswahl gleich gespeichert wird
      document.querySelector<HTMLButtonElement>(`.theme button[data-theme="${r.a.slice(6)}"]`)?.click();
      dialog.close();
    }
  }

  // Strg/⌘ K öffnet und schliesst, "/" öffnet (ausser beim Tippen in einem Feld)
  document.addEventListener('keydown', e => {
    if (e.key.toLowerCase() === 'k' && (e.metaKey || e.ctrlKey) && !e.altKey && !e.shiftKey) {
      e.preventDefault();
      if (dialog.open) dialog.close(); else open();
    } else if (e.key === '/' && !e.metaKey && !e.ctrlKey && !e.altKey) {
      const typing = (e.target as Element).closest?.('input, textarea, select, [contenteditable]');
      if (!typing && !dialog.open) { e.preventDefault(); open(); }
    }
  });

  const button = document.querySelector<HTMLButtonElement>('.search-button');
  if (button) {
    button.addEventListener('click', open);
    // Apple-Geräte zeigen ⌘ statt Ctrl
    if (/Mac|iPhone|iPad/.test(navigator.platform)) button.querySelector('kbd')!.textContent = '⌘K';
    button.hidden = false;
  }
</script>
