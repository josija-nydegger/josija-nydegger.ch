---
// Gemeinsames Layout für alle Seiten und Beiträge (Deutsch und Englisch): Kopf, Menü, Sprachumschalter, Fusszeile.
// "ref" verbindet eine Seite mit ihrem Gegenstück in der anderen Sprache (src/data/pages.ts bzw. Front Matter der Beiträge).
import Nav from '../components/Nav.astro';
import Seo from '../components/Seo.astro';
import PersonJsonLd from '../components/PersonJsonLd.astro';
import Umami from '../components/Umami.astro';
import Search from '../components/Search.astro';
import { execSync } from 'node:child_process';
import '@fontsource-variable/archivo/wdth.css';
import { i18n, otherLang, type Lang } from '../data/i18n';
import { site, absoluteUrl, pagePath } from '../data/site';
import { counterpartUrl, type Post } from '../lib/posts';

interface Props {
  lang: Lang;
  ref?: string;
  title?: string;
  description?: string;
  post?: Post;
}
const { lang, ref, title, description, post } = Astro.props;
const t = i18n[lang];
const other = otherLang(lang);
const tOther = i18n[other];

// Sprachumschalter: Gegenstück, sonst Startseite der anderen Sprache (bei Beiträgen deren Blog-Übersicht)
const otherUrl = await counterpartUrl(ref, lang);
const switchUrl = otherUrl ?? (post ? tOther.blogUrl : tOther.homeUrl);
const path = pagePath(Astro.url.pathname);
const deUrl = lang === 'de' ? path : otherUrl;

// Plankopf in der Fusszeile: Revision = Git-Commit des Builds, Stand = Build-Datum
let rev = (process.env.GITHUB_SHA ?? '').slice(0, 7);
if (!rev) { try { rev = execSync('git rev-parse --short HEAD').toString().trim(); } catch { rev = 'lokal'; } }
const built = new Date().toLocaleDateString(lang === 'de' ? 'de-CH' : 'en-GB', { timeZone: site.timezone, day: 'numeric', month: lang === 'de' ? 'numeric' : 'short', year: 'numeric' });
const sheet = title ?? (lang === 'de' ? 'Startseite' : 'Home');
---
<!doctype html>
<html lang={lang}>
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <script is:inline>document.documentElement.classList.add("js");try{var t=localStorage.getItem("theme");if(t==="light"||t==="dark")document.documentElement.dataset.theme=t}catch(e){}</script>
  <Seo lang={lang} title={title} description={description} post={post} />
  {(ref === 'home' || ref === 'cv') && <PersonJsonLd lang={lang} />}
  {otherUrl && (
    <>
      <link rel="alternate" hreflang={lang} href={absoluteUrl(path)}>
      <link rel="alternate" hreflang={other} href={absoluteUrl(otherUrl)}>
      <link rel="alternate" hreflang="x-default" href={absoluteUrl(deUrl!)}>
    </>
  )}
  <link rel="alternate" type="application/atom+xml" title={t.feedTitle} href={absoluteUrl(t.feedUrl)}>
  <link rel="icon" href="/favicon.ico" sizes="16x16 32x32 48x48">
  <link rel="icon" href="/favicon.svg" type="image/svg+xml">
  <link rel="icon" href="/favicon-32.png" sizes="32x32" type="image/png">
  <link rel="apple-touch-icon" href="/apple-touch-icon.png">
  <link rel="stylesheet" href="/style.css">
  <Umami />
  <slot name="head" />
</head>
<body>
<header class="site-header">
  <div class="site-header-inner">
    <a class="brand" href={t.homeUrl} aria-label={site.author.name}><img src="/favicon.svg" alt="" width="26" height="26"><span>{site.author.name}</span></a>
    <Nav lang={lang} ref={ref} isPost={!!post} />
    <div class="header-tools">
      <button type="button" class="icon-button search-button" data-search aria-label={t.search} hidden>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg>
        <span class="label">{t.search}</span><kbd>Ctrl K</kbd>
      </button>
      <nav class="lang" aria-label={t.langLabel}>
        {lang === 'de'
          ? <><span aria-current="true">DE</span><a href={switchUrl} hreflang="en" lang="en" title={tOther.name}>EN</a></>
          : <><a href={switchUrl} hreflang="de" lang="de" title={tOther.name}>DE</a><span aria-current="true">EN</span></>}
      </nav>
      <button type="button" class="icon-button theme-toggle" aria-label={t.themeLabel} data-labels={JSON.stringify({ light: t.themeLight, dark: t.themeDark, system: t.themeSystem })} hidden>
        <svg class="i-light" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2m-7.07-17.07 1.41 1.41m11.32 11.32 1.41 1.41M2 12h2m16 0h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41"/></svg>
        <svg class="i-dark" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"/></svg>
        <svg class="i-system" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect width="20" height="14" x="2" y="3" rx="2"/><path d="M8 21h8m-4-4v4"/></svg>
      </button>
      <button type="button" class="icon-button menu-toggle" aria-label={t.menu} aria-expanded="false" hidden>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16"/></svg>
      </button>
    </div>
  </div>
</header>

<main>
  <slot />
</main>

<footer class="site-footer">
  <div class="titleblock">
    <div class="tb-title">
      <div><span class="k">{t.tbSheet}</span><span class="v">{sheet}</span></div>
      <div><span class="k">{site.author.name}</span><span class="v tb-sub">{t.tbSub}</span></div>
    </div>
    <div><span class="k">{t.tbScale}</span><span class="v">1:1</span></div>
    <div><span class="k">{t.tbDrawn}</span><span class="v">JN</span></div>
    <div><span class="k">{t.tbLang}</span><span class="v">{lang.toUpperCase()}</span></div>
    <div><span class="k">{t.tbDate}</span><span class="v">{built}</span></div>
    <div><span class="k">{t.tbRev}</span><span class="v"><a href={`https://github.com/josija-nydegger/josija-nydegger.ch/commit/${rev}`}>{rev}</a></span></div>
    <div><span class="k">Feed</span><span class="v"><a href={t.feedUrl}>RSS</a></span></div>
  </div>
  <div class="footer-row">
    <span>© {new Date().getFullYear()} {site.author.name}</span>
    <a href={t.privacyUrl}>{t.privacy}</a>
  </div>
</footer>

<Search lang={lang} />

<script is:inline define:vars={{ emailB64: site.emailB64 }}>
  // Hell / Dunkel / System: ein Knopf schaltet reihum, Auswahl im Browser gespeichert.
  (function () {
    var root = document.documentElement;
    var button = document.querySelector(".theme-toggle");
    var labels = JSON.parse(button.dataset.labels);
    var order = ["system", "light", "dark"];
    function apply(theme) {
      if (theme === "light" || theme === "dark") root.dataset.theme = theme;
      else { delete root.dataset.theme; theme = "system"; }
      try {
        if (theme === "system") localStorage.removeItem("theme");
        else localStorage.setItem("theme", theme);
      } catch (e) {}
      button.dataset.current = theme;
      button.title = labels[theme];
    }
    button.addEventListener("click", function () {
      apply(order[(order.indexOf(button.dataset.current) + 1) % order.length]);
    });
    apply(root.dataset.theme);
    button.hidden = false;
  })();

  // Kopfzeile: Linie beim Scrollen, Menü auf dem Handy
  (function () {
    var header = document.querySelector(".site-header");
    var toggle = header.querySelector(".menu-toggle");
    var onScroll = function () { header.classList.toggle("scrolled", window.scrollY > 4); };
    window.addEventListener("scroll", onScroll, { passive: true });
    onScroll();
    toggle.hidden = false;
    toggle.addEventListener("click", function () {
      var open = header.classList.toggle("open");
      toggle.setAttribute("aria-expanded", open);
    });
  })();

  // E-Mail-Adresse erst im Browser zusammensetzen (Schutz vor Bots). Ohne JavaScript bleibt sie ausgeblendet.
  (function () {
    var address;
    try { address = atob(emailB64); } catch (e) { return; }
    document.querySelectorAll(".email").forEach(function (a) {
      a.href = "mailto:" + address;
      a.textContent = address;
    });
    document.querySelectorAll(".email-wrap").forEach(function (w) { w.hidden = false; });
  })();

  // Besucherstatistik (Umami, siehe src/components/Umami.astro): Klicks auf PDFs zählen, nur der Dateiname.
  document.addEventListener("click", function (e) {
    var a = e.target.closest && e.target.closest('a[href$=".pdf"]');
    if (a && window.umami) window.umami.track("PDF-Download", { datei: a.pathname.split("/").pop() });
  });

  // Lebenslauf: Button "Als PDF speichern" öffnet den Druckdialog.
  // Während des Druckens wird der Seitentitel (= vorgeschlagener Dateiname) durch data-print ersetzt.
  (function () {
    var button = document.querySelector("[data-print]");
    if (!button) return;
    var title = document.title;
    window.addEventListener("beforeprint", function () { document.title = button.dataset.print; });
    window.addEventListener("afterprint", function () { document.title = title; });
    button.addEventListener("click", function () { window.print(); });
    button.hidden = false;
  })();
</script>
</body>
</html>
