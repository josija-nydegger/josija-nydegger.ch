---
// Layout für Blogbeiträge (baut auf Base auf).
// Zeigt Datum, Lesezeit und Links zum älteren/neueren Beitrag derselben Sprache.
import Base from './Base.astro';
import { i18n, formatDate } from '../data/i18n';
import { getPosts, neighbours, readingTime, type Post } from '../lib/posts';

interface Props {
  post: Post;
  /** Beitrag enthält Formeln: KaTeX-Stil laden (Formeln selbst werden beim Build gesetzt) */
  math?: boolean;
}
const { post, math = false } = Astro.props;
const t = i18n[post.lang];
const minutes = readingTime(post.entry.rendered?.html ?? '');
const { older, newer } = neighbours(await getPosts(post.lang), post);
---
<Base lang={post.lang} ref={post.ref} title={post.title} description={post.description} post={post}>
  {math && <link slot="head" rel="stylesheet" href="/assets/katex/katex.min.css">}

  <a class="back" href={t.blogUrl}>← {t.allPosts}</a>

  <div class="progress" aria-hidden="true"></div>
  <div class="post-layout">
    <article data-copy={t.copy} data-copied={t.copied}>
      <h1>{post.title}</h1>
      <div class="date">{formatDate(post.date, post.lang)} · {minutes} {t.readingTime}</div>
      <slot />
    </article>
    <aside class="toc" aria-label={t.toc} hidden>
      <p>{t.toc}</p>
      <ol></ol>
    </aside>
  </div>

  {(older || newer) && (
    <nav class="post-nav" aria-label={t.postNav}>
      {older && <a class="prev" href={older.url}><span>← {t.prevPost}</span>{older.title}</a>}
      {newer && <a class="next" href={newer.url}><span>{t.nextPost} →</span>{newer.title}</a>}
    </nav>
  )}
</Base>

<script>
  const article = document.querySelector<HTMLElement>('article')!;

  // Inhaltsverzeichnis aus den Zwischentiteln, aktiver Abschnitt hervorgehoben
  const toc = document.querySelector<HTMLElement>('.toc')!;
  const heads = [...article.querySelectorAll<HTMLElement>('h2[id], h3[id]')];
  if (heads.length >= 2) {
    const ol = toc.querySelector('ol')!;
    const links = heads.map(h => {
      const li = document.createElement('li');
      const a = document.createElement('a');
      a.href = `#${h.id}`;
      a.textContent = h.textContent;
      if (h.tagName === 'H3') a.style.paddingLeft = '12px';
      li.append(a);
      ol.append(li);
      return a;
    });
    toc.hidden = false;
    const io = new IntersectionObserver(entries => {
      for (const e of entries) if (e.isIntersecting) {
        links.forEach(a => a.classList.toggle('active', a.hash === `#${e.target.id}`));
      }
    }, { rootMargin: '0px 0px -70% 0px' });
    heads.forEach(h => io.observe(h));
  }

  // Anker-Link (#) neben jedem Zwischentitel
  heads.forEach(h => {
    const a = document.createElement('a');
    a.className = 'anchor';
    a.href = `#${h.id}`;
    a.setAttribute('aria-hidden', 'true');
    a.tabIndex = -1;
    a.textContent = '#';
    h.prepend(a);
  });

  // Kopieren-Knopf an Codeblöcken
  article.querySelectorAll('pre').forEach(pre => {
    const b = document.createElement('button');
    b.type = 'button';
    b.className = 'copy-code';
    b.textContent = article.dataset.copy ?? 'Copy';
    b.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(pre.querySelector('code')?.innerText ?? pre.innerText);
        b.textContent = article.dataset.copied ?? 'Copied';
        setTimeout(() => (b.textContent = article.dataset.copy ?? 'Copy'), 1600);
      } catch { /* Zwischenablage nicht erlaubt */ }
    });
    pre.append(b);
  });

  // Lesefortschritt
  const bar = document.querySelector<HTMLElement>('.progress')!;
  const update = () => {
    const r = article.getBoundingClientRect();
    const total = r.height - window.innerHeight;
    bar.style.transform = `scaleX(${total > 0 ? Math.min(1, Math.max(0, -r.top / total)) : 1})`;
  };
  window.addEventListener('scroll', update, { passive: true });
  update();
</script>
