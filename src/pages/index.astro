---
// Startseite (Deutsch), /. Änderungen auch in src/pages/en/index.astro nachführen.
import Base from '../layouts/Base.astro';
import BlogList from '../components/BlogList.astro';
import HeroBeam from '../components/HeroBeam.astro';
import { postUrl } from '../lib/posts';

// Blog-Tag bei Projekten erst, wenn der Beitrag veröffentlicht ist (Datum erreicht)
const qrPost = await postUrl('qr-tool', 'de');
---
<Base
  lang="de"
  ref="home"
>

  <!-- ===== Kopf mit interaktivem Balken ===== -->
  <div class="hero">
    <h1 class="hero-name">Josija<br>Nydegger</h1>
    <div class="hero-row">
      <div>
        <p class="hero-lead">Ich bin Bauingenieur-Student, wohne mit meiner Frau Prisca in Lyss und interessiere mich dafür, Ingenieurarbeit mit eigener Software zu vereinfachen.</p>
        <div class="hero-actions">
          <a class="button primary" href="/cv">Lebenslauf</a>
          <a class="button" href="/tools/">Tools ansehen</a>
          <a class="button" href="#kontakt">Kontakt</a>
        </div>
      </div>
      <img class="avatar" src="/images/profil.jpg" alt="Josija Nydegger" width="92" height="92" onerror="this.style.display='none'">
    </div>
    <HeroBeam lang="de" />
  </div>

  <section class="sheet" id="ueber">
    <h2 class="rail"><span class="axis">A</span>Über mich</h2>
    <div class="prose">
    <h3>Aktuell</h3>
    <p>
      Ich studiere Bauingenieurwesen in Teilzeit an der <a href="https://www.bfh.ch">Berner Fachhochschule</a> in Burgdorf
      und arbeite als Werkstudent im Hochbau bei <a href="https://www.baukonstrukt.ch/">Baukonstrukt AG</a> in Biel.
    </p>

    <h3>Schwerpunkte</h3>
    <ul class="bullets">
      <li>Tragwerke</li>
      <li>Digital Construction und BIM (z.&nbsp;B. mit IfcOpenShell)</li>
      <li>Numerische Simulationen</li>
    </ul>

    <h3>Werdegang</h3>
    <p>
      Zuvor studierte ich an der ETH Zürich Bauingenieurwissenschaften und absolvierte ein Basisjahr Informatik.
      In meiner Bachelorarbeit untersuchte ich die Fluid-Struktur-Interaktion eines Windturbinenblatts in COMSOL.
      Danach arbeitete ich im Sozialbereich: im Sekretariat der Abteilung Soziales in Opfikon und im Zivildienst
      in einer niederschwelligen Beratungsstelle in Zürich. Anschliessend kehrte ich zum Bauingenieurwesen zurück
      und arbeitete zwei Jahre als Werkstudent im Tiefbau bei <a href="https://www.bsb-partner.ch/">BSB + Partner</a> in Bern.
    </p>

    <h3>Ausserhalb der Arbeit</h3>
    <p>
      Ich programmiere kleine Tools (<a href="https://github.com/josija-nydegger">GitHub</a>)
      und laufe Distanzen von 10&nbsp;km bis zum Marathon (<a href="https://www.strava.com/athletes/8047977">Strava</a>).
    </p>
    </div>
  </section>

  <!-- ===== Arbeiten ===== -->
  <section class="sheet" id="arbeiten">
    <h2 class="rail"><span class="axis">B</span>Arbeiten</h2>
    <ul class="list">
      <!-- PDF hinzufügen: Datei in den Ordner "arbeiten" hochladen und unter dem Eintrag einfügen:
           <div class="tags"><a class="tag" href="/arbeiten/DATEINAME.pdf" target="_blank" rel="noopener">PDF</a></div> -->
      <li class="item">
        <div class="item-head">
          <p class="item-title">Analyse der Einsturzwahrscheinlichkeit von Strassenbrücken in den USA</p>
          <span class="item-year">2026</span>
        </div>
        <p class="item-sub">Projektarbeit, Berner Fachhochschule (in Arbeit)</p>
      </li>
      <li class="item">
        <div class="item-head">
          <p class="item-title">Simulating the fluid-structure interaction of a wind turbine blade in COMSOL</p>
          <span class="item-year">2021</span>
        </div>
        <p class="item-sub">Bachelorarbeit, ETH Zürich · zusammen mit Fabrizio Bruschetti</p>
        <div class="tags"><a class="tag" href="/arbeiten/bachelorarbeit-eth-windturbine.pdf" target="_blank" rel="noopener">PDF</a></div>
      </li>
    </ul>
  </section>

  <!-- ===== Projekte ===== -->
  <section class="sheet" id="projekte">
    <h2 class="rail"><span class="axis">C</span>Projekte</h2>
    <ul class="list">
      <li class="item">
        <div class="item-head">
          <p class="item-title"><img class="item-icon" src="/images/projekte/qr-tool.png" alt="" width="40" height="40" loading="lazy">QR-tool</p>
        </div>
        <p class="item-sub">Prototyp für einseitige, netzwerkfreie Datenübertragung vom Computer aufs Smartphone über eine Folge von QR-Codes, mit optionaler AES-256-Verschlüsselung und Fountain-Codes gegen verlorene Frames.</p>
        <div class="tags">
          <a class="tag" href="https://github.com/josija-nydegger/QR-tool" target="_blank" rel="noopener">Code</a>
          <a class="tag" href="https://josija-nydegger.ch/QR-tool/QR-Reader" target="_blank" rel="noopener">Demo</a>
          {qrPost && <a class="tag" href={qrPost}>Blog</a>}
          <span class="tag">HTML / JavaScript</span>
        </div>
      </li>
      <li class="item">
        <div class="item-head">
          <p class="item-title"><img class="item-icon" src="/images/projekte/weather-bot.jpg" alt="" width="40" height="40" loading="lazy">weather-bot</p>
        </div>
        <p class="item-sub">Telegram-Bot, der täglich automatisch eine Wettermeldung verschickt, basierend auf OpenWeatherMap und GitHub Actions.</p>
        <div class="tags">
          <a class="tag" href="https://github.com/josija-nydegger/weather-bot" target="_blank" rel="noopener">Code</a>
          <span class="tag">Python</span>
          <span class="tag">GitHub Actions</span>
        </div>
      </li>
    </ul>
  </section>

  <!-- ===== Blog (wird automatisch aus src/content/blog erzeugt, nur Beiträge dieser Sprache) ===== -->
  <BlogList lang="de" axis="D" />

  <!-- ===== Kontakt ===== -->
  <section class="sheet" id="kontakt">
    <h2 class="rail"><span class="axis">E</span>Kontakt</h2>
    <p class="contact-lead">Am einfachsten erreichst du mich über <a href="https://www.linkedin.com/in/josija-nydegger">LinkedIn</a><span class="email-wrap" hidden> oder per E-Mail an <a class="email"></a></span>.</p>
    <div class="socials">
      <a href="https://www.linkedin.com/in/josija-nydegger" target="_blank" rel="noopener">LinkedIn</a>
      <a href="https://github.com/josija-nydegger" target="_blank" rel="noopener">GitHub</a>
      <a href="https://www.instagram.com/josija.nydegger" target="_blank" rel="noopener">Instagram</a>
      <a href="https://www.strava.com/athletes/8047977" target="_blank" rel="noopener">Strava</a>
      <a href="https://orcid.org/0009-0005-4270-2574" target="_blank" rel="noopener">ORCID</a>
    </div>
  </section>
</Base>
